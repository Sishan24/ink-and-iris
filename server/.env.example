PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration
# Leave empty or unset to automatically use zero-setup mongodb-memory-server, or specify your MongoDB connection string
MONGODB_URI=

# Authentication
JWT_SECRET=ink_and_iris_literary_secret_key_2026_jaya_roy_chowdhury
JWT_EXPIRES_IN=7d

# Email delivery (Resend)
# If not provided, emails and OTPs are safely logged to the server console
RESEND_API_KEY=
EMAIL_FROM=Ink & Iris <noreply@inkandiris.com>
AUTHOR_NOTIFICATION_EMAIL=jaya.roychowdhury@inkandiris.com

# Media Storage (Cloudinary)
# If not provided, files are stored locally in server/uploads and served statically
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
