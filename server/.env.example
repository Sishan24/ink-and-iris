# ---- Server ----
NODE_ENV=development
PORT=5000
# Where the React site runs (used for CORS)
CLIENT_URL=http://localhost:5173

# ---- Database (MongoDB Atlas connection string) ----
MONGODB_URI=mongodb://127.0.0.1:27017/golden-glades

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# This email becomes the admin account (signs in with the same email-code flow)
ADMIN_EMAIL=author@example.com
ADMIN_NAME=Jaya Roy Chowdhury

# ---- Email (Resend). Leave RESEND_API_KEY empty in development: codes print to the terminal ----
RESEND_API_KEY=
EMAIL_FROM=Through the Golden Glades <onboarding@resend.dev>
# Where new "Speak to the Author" messages are announced (defaults to ADMIN_EMAIL)
AUTHOR_NOTIFY_EMAIL=

# ---- Images (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
